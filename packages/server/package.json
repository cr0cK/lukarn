    "argon2": "^0.41.1",
    "better-sqlite3": "^12.2.0",
    "exif-reader": "^2.0.3",
    "fastify": "^5.11.3",
    "fastify-plugin": "^5.0.1",
    "js-yaml": "^4.1.0",
