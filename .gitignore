node_modules/
dist/
*.tsbuildinfo

# Local data — never committed
data/
cache/
.env
config/albums.yaml
# Archives produced by deploy/backup.sh — they contain a copy of the .env.
backups/
# A service account's private key: it is worth read access to the shared folders,
# and nothing expires it.
config/*.json

# Browser automation artefacts (screenshots, snapshots, console logs)
.playwright-cli/
# Design plugin cache, specific to each workstation
.impeccable/

# Git worktrees mounted by agent tooling: branches of this repository, not content
# to commit into it.
.claude/worktrees/
# Per-workstation agent settings: the `.local` in the name already says they only
# apply there, and committing them imposes one machine's permissions on everyone
# who clones.
.claude/settings.local.json

# Misc
.DS_Store
*.log
.eslintcache
