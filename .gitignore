node_modules/
dist/
*.tsbuildinfo

# Données locales — jamais committées
data/
cache/
.env
config/albums.yaml
# Archives produites par deploy/backup.sh — elles contiennent une copie du .env.
sauvegardes/
# Clé privée d'un compte de service : elle vaut l'accès en lecture aux dossiers
# partagés, et rien ne l'expire.
config/*.json

# Artefacts d'automatisation navigateur (captures, snapshots, journaux console)
.playwright-cli/
# Cache du plugin de design impeccable, propre à chaque poste
.impeccable/

# Worktrees git montées par l'outillage d'agents : des branches du dépôt, pas
# du contenu à y committer.
.claude/worktrees/
# Réglages d'agent propres à un poste : le `.local` du nom dit déjà qu'ils ne
# valent que là, et les versionner impose ses permissions à qui clone.
.claude/settings.local.json

# Divers
.DS_Store
*.log
.eslintcache
