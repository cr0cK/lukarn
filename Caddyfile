# HTTPS front end for the gallery. Caddy obtains and renews the Let's Encrypt
# certificate on its own; there is no renewal to schedule.
#
# The site address is `PUBLIC_URL` as it stands, and that is deliberate: the same
# variable builds the OAuth redirect URI and decides whether cookies are `secure`.
# One value to fill in, so there is no way for the domain served and the domain
# declared to diverge — which is this application's classic failure
# (`redirect_uri_mismatch`, or a session cookie that never comes back).
#
# It must therefore be exactly `https://photos.example.com`, with no trailing `/`
# and no port: that is the name Caddy will present to Let's Encrypt.

{$PUBLIC_URL} {
	# WebP derivatives and videos are already compressed; Caddy's default filter
	# leaves them alone and only compresses HTML, JSON and bundles.
	encode zstd gzip

	# The server accepts nothing but short JSON bodies (`bodyLimit` at 64 kB in
	# `app.ts`). Refusing anything larger here avoids tying up Node reading a body
	# it would reject anyway.
	request_body {
		max_size 1MB
	}

	# `lukarn`, and never the service name `app`: compose gives every container its
	# service name as an alias on each network it joins, so a network shared with
	# another application — which is how this Caddy is replaced by one front end
	# serving several sites — has `app` answering from whichever container got
	# there first, per request. The alias is declared in `docker-compose.yml` and
	# resolves in both arrangements (D260817d).
	reverse_proxy lukarn:8080 {
		# Videos are served over `Range`, relayed from Drive as they come:
		# buffering the response before sending it would make the player wait and
		# hold the whole file in memory.
		flush_interval -1
	}

	# Security headers (CSP, HSTS, nosniff…) are set by the application, in
	# `plugins/headers.ts`: they hold in development and behind a different front
	# end as well, and there is only one place to read them.

	log {
		output stdout
	}
}
