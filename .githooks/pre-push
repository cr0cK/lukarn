#!/bin/sh
# Empêche de publier une documentation qui ment : une divergence entre le code et
# les specs, une décision numérotée deux fois ou un renvoi — `(Dxx)` comme lien
# relatif — qui ne mène nulle part.
#
# Le formatage n'est pas contrôlé ici (D75) : il l'est dans `pnpm verify` et dans
# la CI. Bloquer une publication sur un espacement, quand la correction tient en
# un `pnpm format`, coûterait plus d'agacement que la dérive qu'il évite.
#
# Posé sur `pre-push` et non `pre-commit` : commiter une étape intermédiaire est
# légitime, publier un état où la documentation ment ne l'est pas. Les deux
# contrôles prennent une fraction de seconde.
#
# Installé par le script `prepare` du package.json, via `core.hooksPath`.
# Pour passer outre une fois : git push --no-verify

if ! node tools/check-specs.mjs; then
  echo ""
  echo "Publication interrompue. Mets à jour les specs concernées, ou"
  echo "utilise --no-verify si tu sais pourquoi tu contournes."
  exit 1
fi

if ! node tools/check-links.mjs; then
  echo ""
  echo "Publication interrompue. Corrige les renvois, ou"
  echo "utilise --no-verify si tu sais pourquoi tu contournes."
  exit 1
fi
