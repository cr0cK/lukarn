#!/bin/sh
# Prevents publishing documentation that lies: a discrepancy between the code and
# the specs, a duplicated decision identifier, a reference (`(Dxx)` as well as a
# relative link) that leads nowhere, or a change somebody will notice with
# nothing about it in the changelog. It also reads the register of the documents
# a stranger meets first, which drifts in one direction and never back.
#
# Formatting is not checked here (D75): `pnpm verify` and CI check it. Blocking a
# push over whitespace, when `pnpm format` fixes it, would cause more frustration
# than the drift it prevents.
#
# This runs on `pre-push`, not `pre-commit`: committing an intermediate step is
# legitimate, but publishing a state where the documentation lies is not. Both
# checks take a fraction of a second.
#
# Installed by the `prepare` script in package.json, through `core.hooksPath`.
# To bypass it once: git push --no-verify

if ! node tools/check-specs.mjs; then
  echo ""
  echo "Push stopped. Update the affected specs, or"
  echo "use --no-verify if you know why you are bypassing the check."
  exit 1
fi

if ! node tools/check-links.mjs; then
  echo ""
  echo "Push stopped. Fix the references, or"
  echo "use --no-verify if you know why you are bypassing the check."
  exit 1
fi

if ! node tools/check-prose.mjs; then
  echo ""
  echo "Push stopped. A public document has drifted out of register, or"
  echo "use --no-verify if you know why you are bypassing the check."
  exit 1
fi

if ! node tools/check-changelog.mjs; then
  echo ""
  echo "Push stopped. Write what changes under \"## [Unreleased]\", or"
  echo "use --no-verify if you know why you are bypassing the check."
  exit 1
fi
