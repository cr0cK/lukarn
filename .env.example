# --- Image (production, docker-compose) ---
# Which version is pulled from the registry. `latest` follows every release; a
# number pins, and that is what you want if an update should be a decision — a
# `docker compose pull` then replaces nothing until you raise it.
# No effect when building from source (docker-compose.build.yml).
# LUKARN_VERSION=1.0.0

# --- Server ---
PORT=8080
HOST=0.0.0.0
# Public URL of the application. It does three things: build the OAuth redirect
# URI, decide whether cookies are `secure`, and — in production — give Caddy the
# domain it obtains the certificate for.
# Must match exactly the origin you reach the application through, with no
# trailing `/`. In production: PUBLIC_URL=https://photos.example.com
PUBLIC_URL=http://localhost:8080

# Name of this instance: tab title, sign-in screen, and the label under the icon
# once the application sits on a home screen. A restart is enough to change it.
# Keep it short: Android truncates past a dozen characters under the icon.
APP_NAME=Photos

# Language of what the server writes without knowing its reader: the email sent to
# the moderation address below, and a page opened by a browser that asks for
# neither English nor French. Visitors are unaffected — their browser decides, and
# the account menu overrides it. Values: en, fr.
DEFAULT_LOCALE=en

# --- Secrets (generate with: openssl rand -hex 32) ---
# Signs session cookies.
SESSION_SECRET=
# Encrypts the Google refresh token stored in the database. Changing it
# invalidates the existing token: OAuth consent has to be granted again from
# /admin.
TOKEN_KEY=

# --- Drive access: either a service account OR OAuth ---

# Service account (recommended): no consent screen, nothing to renew. GCP console
# > IAM > Service accounts > Keys > JSON, then share each album folder
# READ-ONLY with the account's address (/admin displays it). When set, this key
# takes precedence over the OAuth pair below.
# The path is the one **the server sees**: under Docker, ./config is mounted at
# /app/config, so GOOGLE_SERVICE_ACCOUNT_FILE=/app/config/service-account.json
# GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json

# OAuth: GCP console > APIs and services > Credentials > OAuth client ID (type
# "Web application"). Add PUBLIC_URL + /api/oauth/callback to the authorised
# redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local folder access ---
# The one directory a local-folder storage may read. Empty — the default — means
# the kind is not offered in /admin at all: there is no folder this instance was
# allowed to reach.
# The fence is planted here, by whoever runs the server, and /admin only chooses a
# subfolder under it. An album can therefore never be pointed at /etc, and a
# symlink leading out of the tree is refused rather than followed.
# The path is the one **the server sees**: under Docker, uncomment the
# `./photos:/photos:ro` volume in docker-compose.yml and set STORAGE_LOCAL_ROOT=/photos
STORAGE_LOCAL_ROOT=

# --- Email (comments and notifications) ---
# The two go together: setting only one prevents startup.
# Leaving them empty disables comments — the code that verifies a commenter's
# address is sent by email, and without a mail server nobody can identify
# themselves.
# Percent-encode whatever would break the URL: @ -> %40, / -> %2F, ? -> %3F,
# # -> %23. Startup fails with a message if the URL cannot be read. (+ and : are
# fine.)
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Gallery <gallery@example.com>
#
# Gmail: an app password (16 letters, spaces removed), never the account
# password. See the README, step 4.
# SMTP_URL=smtps://first.last%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
# MAIL_FROM=Gallery <first.last@gmail.com>
SMTP_URL=
MAIL_FROM=
#
# MAIL_FROM carries the address the relay is allowed to sign — the one SPF and
# DKIM cover. Putting something else there to collect replies is the classic
# trap: messages land in spam, or get rewritten, or are rejected, and the address
# verification code stops arriving. MAIL_REPLY_TO below is what sets the reply
# address, never MAIL_FROM.
#
# Where a reply to a notification lands. A transactional relay has no inbox, and
# the sending domain does not necessarily have one either: without this variable,
# replying to a notification bounces. Leave empty if MAIL_FROM's address receives
# its mail.
# MAIL_REPLY_TO=first.last@gmail.com
MAIL_REPLY_TO=

# --- Updates ---
# Where the instance asks whether a newer version has been published. The answer
# becomes an "Update to 1.2.3" badge in /admin and in the account menu, for
# administrators only; nothing updates itself, the badge is a link to the release.
# Asked at most once every six hours, and only while an administrator is looking.
# Leave empty for an instance that contacts nobody.
UPDATE_CHECK_URL=https://api.github.com/repos/cr0cK/lukarn/releases/latest

# --- Photo locations ---
# Reverse geocoding of EXIF coordinates, to show "Bonifacio, Corsica" at the head
# of a day. The pass runs in the background, one request per second, and caches
# its results: two stays in the same place cost one call.
# Leave empty to disable it entirely.
GEOCODING_URL=https://nominatim.openstreetmap.org

# --- Paths (overridden by docker-compose) ---
CONFIG_PATH=./config/albums.yaml
DATA_DIR=./data
CACHE_DIR=./cache
