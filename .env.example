# --- Serveur ---
PORT=8080
HOST=0.0.0.0
# URL publique de l'app. Elle sert à trois choses : construire l'URI de
# redirection OAuth, décider si les cookies sont `secure`, et — en production —
# donner à Caddy le domaine dont il obtient le certificat.
# Doit correspondre exactement à l'origine par laquelle tu accèdes à l'app,
# sans `/` final. En production : PUBLIC_URL=https://photos.exemple.fr
PUBLIC_URL=http://localhost:8080

# --- Secrets (générer avec: openssl rand -hex 32) ---
# Signe les cookies de session.
SESSION_SECRET=
# Chiffre le refresh token Google stocké en base. Le changer invalide le token
# existant : il faudra refaire le consentement OAuth depuis /admin.
TOKEN_KEY=

# --- Accès à Drive : au choix, compte de service OU OAuth ---

# Compte de service (recommandé) : aucun écran de consentement, rien à
# renouveler. Console GCP > IAM > Comptes de service > Clés > JSON, puis
# partager chaque dossier d'album EN LECTURE avec l'adresse du compte
# (/admin l'affiche). Renseignée, cette clé prend le pas sur l'OAuth ci-dessous.
# Le chemin est celui **vu par le serveur** : sous Docker, ./config est monté
# en /app/config, donc GOOGLE_SERVICE_ACCOUNT_FILE=/app/config/service-account.json
# GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json

# OAuth : Console GCP > API et services > Identifiants > ID client OAuth
# (type "Application Web"). Ajouter PUBLIC_URL + /api/oauth/callback dans les
# URI de redirection autorisés.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails (commentaires et notifications) ---
# Les deux vont ensemble : n'en renseigner qu'un empêche le démarrage.
# Laisser vides désactive les commentaires : le code qui vérifie l'adresse d'un
# commentateur part par email, sans serveur d'envoi personne ne peut s'identifier.
# Encoder ce qui coupe l'URL : @ -> %40, / -> %2F, ? -> %3F, # -> %23.
# Le démarrage échoue avec un message si l'URL est illisible. (+ et : passent.)
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.fr:587
# MAIL_FROM=Galerie <galerie@exemple.fr>
#
# Gmail : mot de passe d'application (16 lettres, sans les espaces), jamais le
# mot de passe du compte. Voir le README, étape 4.
# SMTP_URL=smtps://prenom.nom%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
# MAIL_FROM=Galerie <prenom.nom@gmail.com>
SMTP_URL=
MAIL_FROM=

# --- Lieux des photos ---
# Géocodage inverse des coordonnées EXIF, pour afficher « Bonifacio, Corse » en
# tête d'une journée. Le passage tourne en fond, une requête par seconde, et met
# ses résultats en cache : deux séjours au même endroit ne comptent qu'un appel.
# Laisser vide pour le désactiver complètement.
GEOCODING_URL=https://nominatim.openstreetmap.org

# --- Chemins (surchargés par docker-compose) ---
CONFIG_PATH=./config/albums.yaml
DATA_DIR=./data
CACHE_DIR=./cache
