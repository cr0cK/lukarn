# --- Serveur ---
PORT=8080
HOST=0.0.0.0
# URL publique de l'app, utilisée pour construire le redirect OAuth.
# Doit correspondre exactement à l'origine par laquelle tu accèdes à l'app.
PUBLIC_URL=http://localhost:8080

# --- Secrets (générer avec: openssl rand -hex 32) ---
# Signe les cookies de session.
SESSION_SECRET=
# Chiffre le refresh token Google stocké en base. Le changer invalide le token
# existant : il faudra refaire le consentement OAuth depuis /admin.
TOKEN_KEY=

# --- OAuth Google ---
# Console GCP > API et services > Identifiants > ID client OAuth (type "Application Web").
# Ajouter PUBLIC_URL + /api/oauth/callback dans les URI de redirection autorisés.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Chemins (surchargés par docker-compose) ---
CONFIG_PATH=./config/albums.yaml
DATA_DIR=./data
CACHE_DIR=./cache
